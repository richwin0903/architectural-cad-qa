# Compose settings only. API keys and password hashes belong in
# .secrets/runtime.env (created by scripts/init-config.py), never here.
CAD_PUBLIC_ORIGIN=https://localhost:8443
CAD_HTTP_PORT=8323
CAD_HTTPS_PORT=8443
CAD_RUNTIME_ENV=./.secrets/runtime.env

# One Uvicorn worker. Bounded QA concurrency and waiting (waiting is not charged).
CAD_QA_CONCURRENCY=2
CAD_QA_MAX_WAITING=8
CAD_QA_QUEUE_WAIT_SECONDS=90
