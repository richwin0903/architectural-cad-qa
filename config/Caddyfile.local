{
	admin off
	auto_https disable_redirects
}

https://localhost {
	tls internal
	@cad_root path /cad
	redir @cad_root /cad/local-qa 308
	handle_path /cad/* {
		request_body {
			max_size 26MiB
		}
		reverse_proxy app:8000 {
			transport http {
				read_timeout 210s
				write_timeout 210s
				response_header_timeout 210s
			}
		}
	}
	handle / {
		redir /cad/local-qa 308
	}
	handle {
		respond 404
	}
}
